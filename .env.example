# Copy this file to ".env" and fill in the values.

# --- Required to run the Telegram bot ---
# Get one from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# --- Optional: enables real LLM parsing ---
# Without this, the bot falls back to a built-in rule-based parser so it still
# runs and can be tested offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional. Leave blank to use the model's default temperature (recommended).
# Newer models (e.g. the GPT-5 family) ONLY accept the default and will return
# a 400 error if you set this. Older models (e.g. gpt-4o-mini) accept 0 for
# more deterministic parsing.
OPENAI_TEMPERATURE=

# --- Latency tuning (optional) ---
# Parser strategy:
#   llm    = always use the LLM (most accurate; default)
#   hybrid = instant rule-based answers for simple messages, LLM for the rest
#            (recommended for lower latency)
#   rule   = offline rule-based only (fastest, no API cost, less accurate)
PARSER_MODE=llm
# For GPT-5-family reasoning models, "minimal" or "low" dramatically cuts
# latency. Leave blank for non-reasoning models (e.g. gpt-4o-mini).
OPENAI_REASONING_EFFORT=
# Cap the parser's output tokens (its JSON is small). Leave blank for default.
OPENAI_MAX_TOKENS=
# Model used to transcribe voice messages. Requires OPENAI_API_KEY.
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Language hint for transcription (ISO-639-1, e.g. "en", "es", "ms").
# Defaults to "en" to stop Whisper misdetecting short clips as another
# language. Set to blank for automatic language detection.
OPENAI_TRANSCRIBE_LANGUAGE=en
# Vision model used to read grocery/receipt photos. Must support images.
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Optional tuning (sensible defaults shown) ---
# Where the SQLite file lives.
DB_PATH=fridge.db
# Remind about items expiring within this many days.
EXPIRY_REMINDER_DAYS=2
# Daily reminder time in 24h HH:MM, in the server's local timezone.
REMINDER_TIME=09:00
