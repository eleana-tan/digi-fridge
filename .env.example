# Copy this file to ".env" and fill in the values.

# --- Required to run the Telegram bot ---
# Get one from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# --- Optional: enables real LLM parsing ---
# Without this, the bot falls back to a built-in rule-based parser so it still
# runs and can be tested offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional tuning (sensible defaults shown) ---
# Where the SQLite file lives.
DB_PATH=fridge.db
# Remind about items expiring within this many days.
EXPIRY_REMINDER_DAYS=2
# Daily reminder time in 24h HH:MM, in the server's local timezone.
REMINDER_TIME=09:00
