[Unit]
Description=Digi Fridge Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=digifridge
Group=digifridge
WorkingDirectory=/opt/digi-fridge
EnvironmentFile=/opt/digi-fridge/.env
ExecStart=/opt/digi-fridge/.venv/bin/python run.py
Restart=always
RestartSec=5
# Hardening (safe defaults for a long-polling bot)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
